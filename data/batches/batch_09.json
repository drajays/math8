      "type": "practice",
      "subtopic": "Gemini Advanced HOTS · Batch 9",
      "question": "Prove that the sum of any two rational numbers is always a rational number. Give two examples.",
      "answer": "If $\\dfrac{a}{b}$ and $\\dfrac{c}{d}$ are rationals ($b,d\\neq0$), then $\\dfrac{a}{b}+\\dfrac{c}{d}=\\dfrac{ad+bc}{bd}$ is rational. Examples: $\\dfrac12+\\dfrac13=\\dfrac56$; $-\\dfrac34+\\dfrac14=-\\dfrac12$.",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Definition",
          "why": "Rational = $\\dfrac{\\text{integer}}{\\text{non-zero integer}}$.",
          "math": "Take $\\dfrac{a}{b}$, $\\dfrac{c}{d}$."
        },
        {
          "rule": "Add",
          "why": "Common denominator $bd$.",
          "math": "$\\dfrac{ad+bc}{bd}$"
        },
        {
          "rule": "Closure",
          "why": "$ad+bc$ and $bd$ are integers; $bd\\neq0$.",
          "math": "Sum is rational"
        },
        {
          "rule": "Examples",
          "why": "Compute two sums.",
          "math": "$\\dfrac56$, $-\\dfrac12$"
        }
      ],
      "linked_note_id": "CH01-sec-rational-numbers",
      "source": "gemini-batch-09"
    },
