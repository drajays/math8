      "type": "practice",
      "subtopic": "Batch 1 · Detailed Solutions",
      "question": "If $2^5 \\cdot 3^4 \\cdot 5^2 = 2^m \\cdot 3^n \\cdot 5^p$, find $m$, $n$, $p$.",
      "answer": "$m = 5$, $n = 4$, $p = 2$",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Concept",
          "why": "By unique prime factorisation, exponents of matching bases must be equal.",
          "math": "2^5 \\cdot 3^4 \\cdot 5^2 = 2^m \\cdot 3^n \\cdot 5^p"
        },
        {
          "rule": "Compare exponents",
          "why": "Match each prime base.",
          "math": "m = 5,\\; n = 4,\\; p = 2"
        }
      ],
      "explanation": "Unique prime factorisation → $m=5$, $n=4$, $p=2$.",
      "linked_note_id": "CH02-sec-exponents-and-powers",
      "source": "practice-session"
    },
