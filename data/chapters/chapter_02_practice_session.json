      "type": "practice",
      "subtopic": "Batch 1 · Detailed Solutions",
      "question": "Simplify: $\\left[\\dfrac{a^{m+n}}{a^m}\\right]^n \\cdot \\left[\\dfrac{a^{n-p}}{a^n}\\right]^m$.",
      "answer": "$a^{n^2 - pm}$",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "First bracket",
          "why": "Quotient then power rule: $(x^a)^b = x^{ab}$.",
          "math": "\\left[a^{(m+n)-m}\\right]^n = a^{n^2}"
        },
        {
          "rule": "Second bracket",
          "why": "Same rules.",
          "math": "\\left[a^{(n-p)-n}\\right]^m = a^{-pm}"
        },
        {
          "rule": "Multiply",
          "why": "Add exponents.",
          "math": "a^{n^2} \\cdot a^{-pm} = a^{n^2 - pm}"
        }
      ],
      "explanation": "First bracket $a^{n^2}$, second $a^{-pm}$ → $a^{n^2-pm}$.",
      "linked_note_id": "CH02-sec-exponents-and-powers",
      "source": "practice-session"
    },
