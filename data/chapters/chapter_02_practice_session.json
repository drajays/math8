    {
      "id": "Q-CH02-B01-009",
      "chapter": 2,
      "topicId": "math-ch2",
      "type": "practice",
      "subtopic": "Batch 1 · Detailed Solutions",
      "question": "Prove that $\\dfrac{a^m}{a^n} = a^{m-n}$ using laws of exponents (for positive integers $m > n$).",
      "answer": "Proved: cancelling $n$ factors of $a$ leaves $m-n$ factors.",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Definition",
          "why": "$a^m$ is $a$ multiplied $m$ times; $a^n$ is $a$ multiplied $n$ times.",
          "math": "a^m = \\underbrace{a \\cdot a \\cdots a}_{m \\text{ times}}"
        },
        {
          "rule": "Division",
          "why": "Since $m > n$, cancel $n$ factors of $a$ from numerator and denominator.",
          "math": "\\dfrac{a^m}{a^n} = \\underbrace{a \\cdot a \\cdots a}_{m-n \\text{ times}}"
        },
        {
          "rule": "Conclusion",
          "why": "Remaining product equals $a^{m-n}$.",
          "math": "a^{m-n}\\; \\checkmark"
        }
      ],
      "explanation": "Cancel $n$ factors of $a$ → $a^{m-n}$. Proved.",
      "linked_note_id": "CH02-sec-exponents-and-powers",
      "source": "practice-session"
    }
  ]
