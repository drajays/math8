      "type": "practice",
      "subtopic": "Batch 1 · Detailed Solutions",
      "question": "Evaluate: $(3^0 + 4^0 + 5^0) \\times (2^{-3} + 3^{-2})$.",
      "answer": "$\\dfrac{17}{24}$",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Zero exponent",
          "why": "Any non-zero number to power 0 equals 1.",
          "math": "3^0 + 4^0 + 5^0 = 1 + 1 + 1 = 3"
        },
        {
          "rule": "Negative exponents",
          "why": "$x^{-n} = \\frac{1}{x^n}$.",
          "math": "2^{-3} + 3^{-2} = \\dfrac{1}{8} + \\dfrac{1}{9}"
        },
        {
          "rule": "Add fractions",
          "why": "LCM of 8 and 9 is 72.",
          "math": "3 \\times \\left(\\dfrac{9+8}{72}\\right) = 3 \\times \\dfrac{17}{72} = \\dfrac{17}{24}"
        }
      ],
      "explanation": "$(1+1+1)(\\frac{1}{8}+\\frac{1}{9}) = 3 \\times \\frac{17}{72} = \\frac{17}{24}$.",
      "linked_note_id": "CH02-sec-exponents-and-powers",
      "source": "practice-session"
    },
