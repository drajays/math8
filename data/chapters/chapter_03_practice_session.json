      "type": "practice",
      "subtopic": "Batch 1 · Detailed Solutions",
      "question": "Using an algebraic identity, find $(98)^2$ without actual multiplication.",
      "answer": "$9604$",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Identity",
          "why": "Use $(a-b)^2 = a^2 - 2ab + b^2$ with $a=100$, $b=2$.",
          "math": "(100-2)^2"
        },
        {
          "rule": "Expand",
          "why": "Substitute and compute.",
          "math": "10000 - 400 + 4 = 9604"
        }
      ],
      "explanation": "$(100-2)^2 = 10000 - 400 + 4 = 9604$.",
      "linked_note_id": "CH03-sec-squares-and-square-roots",
      "source": "practice-session"
