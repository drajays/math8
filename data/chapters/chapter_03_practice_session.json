      "type": "practice",
      "subtopic": "Batch 1 · Detailed Solutions",
      "question": "A gardener wants to plant $2025$ trees in his garden so that the number of trees in each row equals the number of rows. Find the number of rows.",
      "answer": "$45$ rows",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Set up",
          "why": "If rows $=$ trees per row $= x$, then $x^2 = 2025$.",
          "math": "x^2 = 2025"
        },
        {
          "rule": "Square root",
          "why": "Ends in 25 → root ends in 5; $\\sqrt{2025} = 45$.",
          "math": "x = 45"
        }
      ],
      "explanation": "$x^2 = 2025$ → $x = 45$ rows.",
      "linked_note_id": "CH03-sec-squares-and-square-roots",
      "source": "practice-session"
    },
