          "why": "$1.5 \\times 1.5$.",
          "math": "2.25"
        },
        {
          "rule": "(iii)",
          "why": "Square numerator and denominator separately.",
          "math": "\\left(\\dfrac{25}{36}\\right)^2 = \\dfrac{625}{1296}"
        }
