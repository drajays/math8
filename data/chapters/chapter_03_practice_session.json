      "topicId": "math-ch3",
      "type": "practice",
      "subtopic": "Batch 1 · Detailed Solutions",
      "question": "Find the value of $\\sqrt{3 + 2\\sqrt{2}} + \\sqrt{3 - 2\\sqrt{2}}$.",
      "answer": "$2\\sqrt{2}$",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Perfect squares",
          "why": "$3 + 2\\sqrt{2} = (\\sqrt{2}+1)^2$ and $3 - 2\\sqrt{2} = (\\sqrt{2}-1)^2$.",
          "math": "(\\sqrt{2}+1)^2,\\; (\\sqrt{2}-1)^2"
        },
        {
          "rule": "Simplify",
          "why": "Take square roots and add.",
          "math": "(\\sqrt{2}+1) + (\\sqrt{2}-1) = 2\\sqrt{2}"
        }
      ],
      "explanation": "$(\\sqrt{2}+1) + (\\sqrt{2}-1) = 2\\sqrt{2}$.",
      "linked_note_id": "CH03-sec-squares-and-square-roots",
      "source": "practice-session"
    },
