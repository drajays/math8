      "type": "practice",
      "subtopic": "Batch 1 · Detailed Solutions",
      "question": "Find the smallest number by which $2592$ must be multiplied so that the product is a perfect square.",
      "answer": "$2$",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Prime factorise",
          "why": "Break 2592 into prime powers.",
          "math": "2592 = 2^5 \\cdot 3^4"
        },
        {
          "rule": "Pair factors",
          "why": "Perfect square needs even powers for every prime.",
          "math": "2^5 \\text{ has one unpaired } 2"
        },
        {
          "rule": "Answer",
          "why": "Multiply by 2 to make $2^6$.",
          "math": "2"
        }
      ],
      "explanation": "$2592 = 2^5 \\cdot 3^4$ → multiply by 2.",
      "linked_note_id": "CH03-sec-squares-and-square-roots",
      "source": "practice-session"
