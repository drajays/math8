      "question": "Find the cube root of $17576$ by prime factorisation method.",
      "answer": "$26$",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Factorise",
          "why": "Divide repeatedly by 2, then recognise $13^3$.",
          "math": "17576 = 2^3 \\cdot 13^3"
        },
        {
          "rule": "Cube root",
          "why": "Take one factor from each group of three.",
          "math": "2 \\times 13 = 26"
        }
      ],
      "explanation": "$17576 = 2^3 \\cdot 13^3$ → $\\sqrt[3]{17576} = 26$.",
      "linked_note_id": "CH04-sec-cubes-and-cube-roots",
      "source": "practice-session"
