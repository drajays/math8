      "question": "Find the cube of:\n\n(i) $-7$\n\n(ii) $2.5$\n\n(iii) $\\dfrac{5}{6}$",
      "answer": "(i) $-343$ · (ii) $15.625$ · (iii) $\\dfrac{125}{216}$",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "(i)",
          "why": "Negative × negative × negative = negative.",
          "math": "(-7)^3 = -343"
        },
        {
          "rule": "(ii)",
          "why": "$2.5 \\times 2.5 \\times 2.5$.",
          "math": "15.625"
        },
        {
          "rule": "(iii)",
          "why": "Cube numerator and denominator.",
          "math": "\\left(\\dfrac{5}{6}\\right)^3 = \\dfrac{125}{216}"
        }
      ],
      "explanation": "(i) $-343$ · (ii) 15.625 · (iii) $\\frac{125}{216}$.",
      "linked_note_id": "CH04-sec-cubes-and-cube-roots",
      "source": "practice-session"
    },
