      "type": "practice",
      "subtopic": "Batch 1 · Detailed Solutions",
      "question": "Find the cube root of $13824$.",
      "answer": "$24$",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Group digits",
          "why": "Group in threes from the right: $\\overline{13}\\,\\overline{824}$.",
          "math": "\\overline{13}\\,\\overline{824}"
        },
        {
          "rule": "Units digit",
          "why": "824 ends in 4; only $4^3=64$ ends in 4 → units digit 4.",
          "math": "\\text{units digit } 4"
        },
        {
          "rule": "Tens digit",
          "why": "$2^3=8 \\le 13 < 27=3^3$ → tens digit 2.",
          "math": "\\sqrt[3]{13824} = 24"
        }
      ],
      "explanation": "Estimation: groups $\\overline{13}\\,\\overline{824}$ → cube root 24.",
      "linked_note_id": "CH04-sec-cubes-and-cube-roots",
      "source": "practice-session"
    },
