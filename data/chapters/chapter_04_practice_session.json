      "question": "Find the cube root of $42875$.",
      "answer": "$35$",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Group digits",
          "why": "$\\overline{42}\\,\\overline{875}$.",
          "math": "\\overline{42}\\,\\overline{875}"
        },
        {
          "rule": "Units digit",
          "why": "875 ends in 5; only cubes ending in 5 come from numbers ending in 5.",
          "math": "\\text{units digit } 5"
        },
        {
          "rule": "Tens digit",
          "why": "$3^3=27 < 42 < 64=4^3$ → tens digit 3.",
          "math": "\\sqrt[3]{42875} = 35"
        }
      ],
      "explanation": "Grouping method → cube root 35.",
      "linked_note_id": "CH04-sec-cubes-and-cube-roots",
