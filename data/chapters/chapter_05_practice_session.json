      "topicId": "math-ch5",
      "type": "practice",
      "subtopic": "Batch 1 · Detailed Solutions",
      "question": "A number is formed by two digits. The sum of its digits is $9$. If $27$ is added to the number, the digits are reversed. Find the number.",
      "answer": "$36$",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Algebraic form",
          "why": "Two-digit number: $10x + y$.",
          "math": "x + y = 9"
        },
        {
          "rule": "Reversal condition",
          "why": "$(10x+y)+27 = 10y+x$.",
          "math": "9y - 9x = 27 \\Rightarrow y - x = 3"
        },
        {
          "rule": "Solve",
          "why": "Add equations: $2y=12$.",
          "math": "y=6,\\; x=3 \\Rightarrow 36"
        }
      ],
      "explanation": "$x+y=9$, $y-x=3$ → number 36.",
      "linked_note_id": "CH05-sec-playing-with-numbers",
      "source": "practice-session"
    },
