        },
        {
          "rule": "Rewrite",
          "why": "Express as multiples of 9 plus digit sum.",
          "math": "= 9(111a + 11b + c) + (a+b+c+d)"
        },
        {
          "rule": "Conclusion",
          "why": "First part is a multiple of 9; divisibility depends on digit sum.",
          "math": "\\text{Divisible by 9 iff } (a+b+c+d) \\text{ is divisible by 9}"
        }
      ],
      "explanation": "$abcd = 9(111a+11b+c) + (a+b+c+d)$. Proved.",
      "linked_note_id": "CH05-sec-playing-with-numbers",
