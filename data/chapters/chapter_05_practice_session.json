      "id": "Q-CH05-B02-001",
      "chapter": 5,
      "topicId": "math-ch5",
      "type": "practice",
      "subtopic": "Batch 2 · Detailed Solutions",
      "question": "Express $98765$ in the generalised form and check divisibility by $11$.",
      "answer": "$98765$ is not divisible by $11$ (alternating difference $= 7$).",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Generalised form",
          "why": "Expand by place value.",
          "math": "9 \\times 10000 + 8 \\times 1000 + 7 \\times 100 + 6 \\times 10 + 5"
        },
        {
          "rule": "Rule for 11",
          "why": "Alternating sum (from right): odd positions minus even positions must be 0 or a multiple of 11.",
          "math": "(5+7+9) - (6+8) = 21 - 14 = 7"
        },
        {
          "rule": "Conclusion",
          "why": "$7$ is not 0 or a multiple of 11.",
          "math": "98765 \\text{ is not divisible by } 11"
        }
      ],
      "explanation": "Alternating sum: $(5+7+9)-(6+8)=7$ → not divisible by 11.",
      "linked_note_id": "CH05-sec-playing-with-numbers",
      "source": "practice-session"
    },
