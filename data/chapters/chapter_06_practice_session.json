      "id": "Q-CH06-B02-005",
      "chapter": 6,
      "topicId": "math-ch6",
      "type": "practice",
      "subtopic": "Batch 2 · Detailed Solutions",
      "question": "Prove that $A \\cup B = B \\cup A$ using sets from $U = \\{1,\\ldots,10\\}$.",
      "answer": "Proved with example: $\\{1,2,3\\}\\cup\\{3,4,5\\}=\\{1,2,3,4,5\\}$ both ways.",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Choose sets",
          "why": "Example from $U$.",
          "math": "A = \\{1,2,3\\},\\; B = \\{3,4,5\\}"
        },
        {
          "rule": "LHS",
          "why": "Union of $A$ and $B$.",
          "math": "A \\cup B = \\{1,2,3,4,5\\}"
        },
        {
          "rule": "RHS",
          "why": "Union of $B$ and $A$.",
          "math": "B \\cup A = \\{1,2,3,4,5\\}"
        },
        {
          "rule": "Conclusion",
          "why": "Commutative property of union.",
          "math": "A \\cup B = B \\cup A\\; \\checkmark"
        }
      ],
      "explanation": "Example shows $A\\cup B = B\\cup A$. Proved.",
      "linked_note_id": "CH06-sec-operations-on-sets",
      "source": "practice-session"
    },
