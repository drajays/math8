      "type": "practice",
      "subtopic": "Batch 2 · Detailed Solutions",
      "question": "Convert: (i) $\\dfrac{3}{8}$ into percent (ii) $0.075$ into percent (iii) $125\\%$ into fraction.",
      "answer": "(i) $37.5\\%$ · (ii) $7.5\\%$ · (iii) $\\dfrac{5}{4}$",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "(i)",
          "why": "Multiply by $100\\%$.",
          "math": "\\dfrac{3}{8} \\times 100\\% = 37.5\\%"
        },
        {
          "rule": "(ii)",
          "why": "Multiply by $100\\%$.",
          "math": "0.075 \\times 100\\% = 7.5\\%"
        },
        {
          "rule": "(iii)",
          "why": "Divide by 100 and simplify.",
          "math": "125\\% = \\dfrac{125}{100} = \\dfrac{5}{4}"
        }
      ],
      "explanation": "(i) 37.5% · (ii) 7.5% · (iii) $\\frac{5}{4}$.",
      "linked_note_id": "CH07-sec-percentage",
      "source": "practice-session"
    },
