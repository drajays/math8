        {
          "rule": "Passed both",
          "why": "Complement.",
          "math": "100\\% - 40\\% = 60\\%"
        }
      ],
      "explanation": "40% fail at least one → 60% pass both.",
      "linked_note_id": "CH07-sec-percentage-and-its-applications",
