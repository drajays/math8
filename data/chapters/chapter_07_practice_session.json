      "question": "In an examination, $30\\%$ failed in English, $25\\%$ in Maths. If $15\\%$ failed in both, find $\\%$ who passed in both subjects.",
      "answer": "$60\\%$",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Failed in at least one",
          "why": "Set formula on percentages.",
          "math": "30 + 25 - 15 = 40\\%"
