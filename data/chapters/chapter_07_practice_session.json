        {
          "rule": "Second part",
          "why": "Reverse ratio.",
          "math": "\\dfrac{12.5}{2.5} \\times 100 = 500\\%"
        }
      ],
      "explanation": "2.5 is 20% of 12.5; 12.5 is 500% of 2.5.",
