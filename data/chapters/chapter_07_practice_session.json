      "topicId": "math-ch7",
      "type": "practice",
      "subtopic": "Batch 2 · Detailed Solutions",
      "question": "A number is increased by $20\\%$ and then decreased by $20\\%$. Find the net percentage change.",
      "answer": "$4\\%$ decrease",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Assume 100",
          "why": "Convenient base.",
          "math": "100 \\xrightarrow{+20\\%} 120 \\xrightarrow{-20\\%} 96"
        },
        {
          "rule": "Net change",
          "why": "$100-96=4$.",
          "math": "4\\% \\text{ decrease}"
        },
        {
          "rule": "Shortcut",
          "why": "Equal $\\pm x\\%$ gives loss $x^2/100$.",
          "math": "20^2/100 = 4\\%"
        }
      ],
      "explanation": "100 → 120 → 96: net 4% decrease.",
      "linked_note_id": "CH07-sec-percentage-and-its-applications",
      "source": "practice-session"
    },
