      "id": "Q-CH09-B03-008",
      "chapter": 9,
      "topicId": "math-ch9",
      "type": "practice",
      "subtopic": "Batch 3 · Detailed Solutions",
      "question": "$6$ men or $10$ women can finish a piece of work in $24$ days. In how many days will $12$ men and $15$ women finish the work?",
      "answer": "$6\\dfrac{6}{7}$ days",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Convert to women",
          "why": "$6$ men $= 10$ women → $1$ man $= \\frac{5}{3}$ women.",
          "math": "12 \\text{ men} = 20 \\text{ women}"
        },
        {
          "rule": "Total workforce",
          "why": "20 + 15 = 35 women.",
          "math": "35 \\text{ women}"
        },
        {
          "rule": "Inverse variation",
          "why": "$10 \\times 24 = 35 \\times d$.",
          "math": "d = \\dfrac{240}{35} = \\dfrac{48}{7} = 6\\dfrac{6}{7}"
        }
      ],
      "explanation": "35 women-equivalent → $\\frac{48}{7}$ days.",
      "linked_note_id": "CH09-sec-direct-and-inverse-variation",
      "source": "practice-session"
    }
