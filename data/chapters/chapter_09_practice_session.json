      "question": "A garrison of $500$ men had provisions for $24$ days. A reinforcement of $100$ men arrived. For how many days will the food last now?",
      "answer": "$20$ days",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Total man-days",
          "why": "Food fixed.",
          "math": "500 \\times 24 = 12000"
        },
        {
          "rule": "New days",
          "why": "600 men share the same total.",
          "math": "600 \\times d = 12000 \\Rightarrow d = 20"
        }
      ],
      "explanation": "12000 man-days ÷ 600 men = 20 days.",
      "linked_note_id": "CH09-sec-direct-and-inverse-variation",
      "source": "practice-session"
