      "subtopic": "Batch 3 · Detailed Solutions",
      "question": "If $x$ varies directly as $y$ and $x = 12$ when $y = 4$, find $x$ when $y = 15$.",
      "answer": "$x = 45$",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Concept",
          "why": "Direct variation: $\\frac{x_1}{y_1} = \\frac{x_2}{y_2}$.",
          "math": "\\dfrac{12}{4} = \\dfrac{x}{15}"
        },
        {
          "rule": "Solve",
          "why": "Simplify and cross-multiply.",
          "math": "3 = \\dfrac{x}{15} \\Rightarrow x = 45"
        }
      ],
      "explanation": "$\\frac{12}{4} = \\frac{x}{15}$ → $x = 45$.",
      "linked_note_id": "CH09-sec-direct-and-inverse-variation",
      "source": "practice-session"
    },
