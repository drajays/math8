      "question": "If $10$ men can complete a work in $12$ days, how many men are required to complete the same work in $8$ days?",
      "answer": "$15$ men",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Concept",
          "why": "Inverse variation: $m_1 d_1 = m_2 d_2$.",
          "math": "10 \\times 12 = m_2 \\times 8"
        },
        {
          "rule": "Solve",
          "why": "Divide.",
          "math": "120 = 8 m_2 \\Rightarrow m_2 = 15"
        }
      ],
      "explanation": "$10 \\times 12 = 8 m_2$ → 15 men.",
      "linked_note_id": "CH09-sec-direct-and-inverse-variation",
      "source": "practice-session"
    },
