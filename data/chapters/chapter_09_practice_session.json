      "question": "$x$ varies inversely as $y$. When $x = 15$, $y = 4$. Find $y$ when $x = 20$.",
      "answer": "$y = 3$",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Constant",
          "why": "$xy = k$.",
          "math": "k = 15 \\times 4 = 60"
        },
        {
          "rule": "Solve",
          "why": "Substitute $x = 20$.",
          "math": "20y = 60 \\Rightarrow y = 3"
        }
      ],
      "explanation": "$k = 60$ → $y = 3$ when $x = 20$.",
      "linked_note_id": "CH09-sec-direct-and-inverse-variation",
      "source": "practice-session"
