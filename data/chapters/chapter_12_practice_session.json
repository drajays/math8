      "type": "practice",
      "subtopic": "Batch 4 · Detailed Solutions",
      "question": "The perimeter of a rectangle is $40$ cm. If its length is $4$ cm more than its breadth, find the dimensions.",
      "answer": "Breadth $= 8$ cm; Length $= 12$ cm",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Let breadth",
          "why": "$B = x$, length $L = x + 4$.",
          "math": "P = 2(L+B)"
        },
        {
          "rule": "Equation",
          "why": "Substitute into perimeter formula.",
          "math": "2(x+x+4)=40 \\Rightarrow 4x+8=40"
        },
        {
          "rule": "Solve",
          "why": "$4x=32$.",
          "math": "x=8;\\; L=12"
        }
      ],
      "explanation": "Breadth 8 cm, length 12 cm.",
      "linked_note_id": "CH12-sec-linear-equations-and-inequalities-in-one-variabl",
      "source": "practice-session"
