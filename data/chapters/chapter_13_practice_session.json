      "question": "Prove that the diagonals of a parallelogram bisect each other.",
      "answer": "Proved: $AO=OC$, $BO=OD$ by ASA congruence of $\\triangle AOB$ and $\\triangle COD$.",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Congruence setup",
          "why": "In $\\parallelogram$ $ABCD$, diagonals meet at $O$.",
          "math": "AB=CD,\\; \\angle OAB=\\angle OCD,\\; \\angle OBA=\\angle ODC"
        },
        {
          "rule": "ASA",
          "why": "$\\triangle AOB \\cong \\triangle COD$.",
          "math": "AO=OC,\\; BO=OD"
        }
      ],
      "explanation": "ASA on $\\triangle AOB$, $\\triangle COD$ → diagonals bisect. Proved.",
      "linked_note_id": "CH13-sec-quadrilateral",
      "source": "practice-session"
