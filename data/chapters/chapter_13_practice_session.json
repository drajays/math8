      "topicId": "math-ch13",
      "type": "practice",
      "subtopic": "Batch 4 · Detailed Solutions",
      "question": "Prove that the sum of exterior angles of any polygon is $360°$ (one at each vertex).",
      "answer": "Proved.",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Linear pairs",
          "why": "At each vertex: $i_k+e_k=180°$.",
          "math": "\\sum(i_k+e_k)=180°\\cdot n"
        },
        {
          "rule": "Interior sum",
          "why": "$\\sum i_k=(n-2)\\cdot 180°$.",
          "math": "(n-2)180°+\\sum e=180°n"
        },
        {
          "rule": "Conclusion",
          "why": "Simplify.",
          "math": "\\sum e=360°\\; \\checkmark"
        }
      ],
      "explanation": "Interior + exterior argument → 360°. Proved.",
      "linked_note_id": "CH13-sec-understanding-shapes",
      "source": "practice-session"
    },
