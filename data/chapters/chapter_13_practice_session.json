      "question": "Find the sum of interior angles of a polygon with $9$ sides. Also find each interior angle if regular.",
      "answer": "Sum $= 1260°$; each regular interior angle $= 140°$",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Sum formula",
          "why": "$(n-2)\\times 180°$.",
          "math": "(9-2)\\times 180°=1260°"
        },
        {
          "rule": "Regular polygon",
          "why": "Divide by $n$.",
          "math": "1260°/9=140°"
        }
      ],
      "explanation": "Sum 1260°; each angle 140°.",
      "linked_note_id": "CH13-sec-understanding-shapes",
      "source": "practice-session"
