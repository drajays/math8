      "type": "practice",
      "subtopic": "Batch 4 · Detailed Solutions",
      "question": "Prove that in any triangle, the sum of angles is $180°$.",
      "answer": "Proved.",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Construction",
          "why": "Through $A$, draw line parallel to $BC$.",
          "math": "XY \\parallel BC"
        },
        {
          "rule": "Alternate angles",
          "why": "$\\angle XAB=\\angle B$, $\\angle YAC=\\angle C$.",
          "math": "\\angle XAB+\\angle A+\\angle YAC=180°"
        },
        {
          "rule": "Conclusion",
          "why": "Substitute.",
          "math": "\\angle A+\\angle B+\\angle C=180°\\; \\checkmark"
        }
      ],
      "explanation": "Parallel line + alternate angles → 180°. Proved.",
      "linked_note_id": "CH13-sec-understanding-shapes",
      "source": "practice-session"
    },
