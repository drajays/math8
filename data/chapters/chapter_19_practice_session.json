      "type": "practice",
      "subtopic": "Batch 5 · Detailed Solutions",
      "question": "The diagonals of a rhombus are $16$ cm and $12$ cm. Find its area.",
      "answer": "$96$ cm²",
      "options": [],
      "glassboxSteps": [
