      "type": "practice",
      "subtopic": "Batch 5 · Detailed Solutions",
      "question": "Find the area of a trapezium whose parallel sides are $25$ cm and $15$ cm and the distance between them is $12$ cm.",
      "answer": "$240$ cm²",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Formula",
          "why": "Area $= \\frac{1}{2}(a+b)h$.",
          "math": "\\frac{1}{2}(25+15)\\times12"
        },
        {
          "rule": "Calculate",
          "why": "Simplify.",
          "math": "20\\times12=240 \\text{ cm}^2"
        }
      ],
      "explanation": "Area = 240 cm².",
      "linked_note_id": "CH19-sec-area-and-perimeter-of-some-plane-figures",
      "source": "practice-session"
    },
    {
      "id": "Q-CH19-B05-002",
      "chapter": 19,
      "topicId": "math-ch19",
      "type": "practice",
      "subtopic": "Batch 5 · Detailed Solutions",
      "question": "The area of a trapezium is $480$ cm² and the distance between parallel sides is $15$ cm. If one parallel side is $20$ cm, find the other.",
      "answer": "$44$ cm",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Substitute",
          "why": "Use area formula.",
          "math": "480=\\frac{1}{2}(20+b)\\times15"
        },
        {
          "rule": "Solve",
          "why": "Multiply by 2, divide by 15.",
          "math": "960=15(20+b) \\Rightarrow 64=20+b \\Rightarrow b=44"
        }
      ],
      "explanation": "Other parallel side = 44 cm.",
      "linked_note_id": "CH19-sec-area-and-perimeter-of-some-plane-figures",
      "source": "practice-session"
    },
    {
      "id": "Q-CH19-B05-003",
      "chapter": 19,
      "topicId": "math-ch19",
      "type": "practice",
      "subtopic": "Batch 5 · Detailed Solutions",
      "question": "Find the area of a regular hexagon with side $6$ cm.",
      "answer": "$54\\sqrt{3}$ cm²",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Decompose",
          "why": "Hexagon = 6 equilateral triangles.",
          "math": "A_{\\triangle}=\\frac{\\sqrt{3}}{4}s^2"
        },
        {
          "rule": "Calculate",
          "why": "Side $=6$.",
          "math": "6\\times\\frac{\\sqrt{3}}{4}\\times36=54\\sqrt{3}"
        }
      ],
      "explanation": "Area = $54\\sqrt{3}$ cm².",
      "linked_note_id": "CH19-sec-area-and-perimeter-of-some-plane-figures",
      "source": "practice-session"
    },
    {
