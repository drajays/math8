      "type": "practice",
      "subtopic": "Batch 5 · Detailed Solutions",
      "question": "Find the area of a regular pentagon with side $8$ cm.",
      "answer": "$\\approx 110.11$ cm²",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Central angle",
          "why": "$360°/5=72°$; half-angle $36°$, half-base $4$ cm.",
          "math": "a=\\frac{4}{\\tan36°}\\approx5.505"
        },
        {
          "rule": "One triangle",
          "why": "$\\frac{1}{2}\\times8\\times a$.",
          "math": "\\approx22.02"
        },
        {
          "rule": "Total",
          "why": "Five identical triangles.",
          "math": "5\\times22.02\\approx110.11"
        }
      ],
      "explanation": "Area $\\approx 110.11$ cm².",
      "linked_note_id": "CH19-sec-area-and-perimeter-of-some-plane-figures",
      "source": "practice-session"
    },
