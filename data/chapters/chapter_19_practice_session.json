      "type": "practice",
      "subtopic": "Batch 5 · Detailed Solutions",
      "question": "The curved surface area of a cylinder is $440$ cm² and its height is $10$ cm. Find its volume ($\\pi=22/7$).",
      "answer": "$1540$ cm³",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Find $r$",
          "why": "$CSA=2\\pi rh$.",
          "math": "440=2\\times\\frac{22}{7}\\times r\\times10 \\Rightarrow r=7"
        },
        {
          "rule": "Volume",
          "why": "$\\pi r^2h$.",
          "math": "\\frac{22}{7}\\times49\\times10=1540"
        }
      ],
      "explanation": "Radius 7 cm; volume 1540 cm³.",
      "linked_note_id": "CH19-sec-volume-and-capacity",
      "source": "practice-session"
    },
