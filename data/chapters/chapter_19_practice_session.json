      "question": "The ratio of radii of two cylinders is $2:3$ and their heights are in ratio $5:4$. Find the ratio of their volumes.",
      "answer": "$5:9$",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Volume ratio",
          "why": "$V\\propto r^2h$.",
          "math": "\\frac{V_1}{V_2}=\\left(\\frac{2}{3}\\right)^2\\times\\frac{5}{4}"
        },
        {
          "rule": "Simplify",
          "why": "Cancel common factors.",
          "math": "\\frac{4}{9}\\times\\frac{5}{4}=\\frac{5}{9}"
        }
      ],
      "explanation": "Volume ratio = 5:9.",
      "linked_note_id": "CH19-sec-volume-and-capacity",
      "source": "practice-session"
