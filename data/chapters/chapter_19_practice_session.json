      "type": "practice",
      "subtopic": "Batch 5 · Detailed Solutions",
      "question": "A field is trapezium-shaped with parallel sides $25$ m and $10$ m, and non-parallel sides $14$ m and $13$ m. Find the area.",
      "answer": "$196$ m²",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Divide",
          "why": "Drop line parallel to 13 m side → parallelogram + triangle (sides 13, 14, 15).",
          "math": "s=21"
        },
        {
          "rule": "Heron",
          "why": "Triangle area.",
          "math": "\\sqrt{21\\times8\\times7\\times6}=84"
        },
        {
          "rule": "Height",
          "why": "$84=\\frac{1}{2}\\times15\\times h$.",
          "math": "h=11.2"
        },
        {
          "rule": "Trapezium",
          "why": "Apply formula.",
          "math": "\\frac{1}{2}(25+10)\\times11.2=196"
        }
      ],
      "explanation": "Area = 196 m².",
      "linked_note_id": "CH19-sec-area-and-perimeter-of-some-plane-figures",
      "source": "practice-session"
