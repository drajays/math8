    {
      "id": "Q-CH20-B05-005",
      "chapter": 20,
      "topicId": "math-ch20",
      "type": "practice",
      "subtopic": "Batch 5 · Detailed Solutions",
      "question": "In a survey of 60 people, use set notation to find only tea, only coffee, given totals for tea, coffee, and both.",
      "answer": "Only tea $= n(T)-n(T\\cap C)$; Only coffee $= n(C)-n(T\\cap C)$; sum with neither $=60$.",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Union formula",
          "why": "$n(T\\cup C)=n(T)+n(C)-n(T\\cap C)$.",
          "math": "60=n(T)+n(C)-x+\\text{neither}"
        },
        {
          "rule": "Only sets",
          "why": "Subtract overlap.",
          "math": "\\text{only T}=n(T)-x,\\;\\text{only C}=n(C)-x"
        }
      ],
      "explanation": "Use Venn diagram or inclusion–exclusion.",
      "linked_note_id": "CH20-sec-data-handling",
      "source": "practice-session"
    },
