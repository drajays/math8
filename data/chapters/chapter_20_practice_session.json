      "chapter": 20,
      "topicId": "math-ch20",
      "type": "practice",
      "subtopic": "Batch 5 · Detailed Solutions",
      "question": "The mean of 5 numbers is $18$. If one number is excluded, the mean becomes $16$. Find the excluded number.",
      "answer": "$26$",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Sum of 5",
          "why": "Mean $\\times$ count.",
          "math": "5\\times18=90"
        },
        {
          "rule": "Sum of 4",
          "why": "After exclusion.",
          "math": "4\\times16=64"
        },
        {
          "rule": "Excluded",
          "why": "Difference.",
          "math": "90-64=26"
        }
      ],
      "explanation": "Excluded number = 26.",
      "linked_note_id": "CH20-sec-data-handling",
      "source": "practice-session"
    },
