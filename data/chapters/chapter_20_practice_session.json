      "type": "practice",
      "subtopic": "Batch 5 · Detailed Solutions",
      "question": "Draw a pie chart for: Cricket $45\\%$, Football $30\\%$, Hockey $15\\%$, Others $10\\%$. Calculate central angles.",
      "answer": "Cricket $162°$ · Football $108°$ · Hockey $54°$ · Others $36°$",
      "options": [],
      "glassboxSteps": [
        {
          "rule": "Formula",
          "why": "Angle $=\\frac{\\%}{100}\\times360°$.",
          "math": "0.45\\times360=162"
        },
        {
          "rule": "All angles",
          "why": "Compute each sector.",
          "math": "108,\\;54,\\;36"
        }
      ],
      "explanation": "Angles: 162°, 108°, 54°, 36° (sum 360°).",
      "linked_note_id": "CH20-sec-data-handling",
      "source": "practice-session"
    },
